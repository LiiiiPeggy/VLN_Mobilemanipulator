# ################################
# Source before run_apexnav_real_episode.sh for the integrate worktree.
# ################################
export CONTAINER=vln-rangercr10-integrate
# Prefer private integrate devel when present; else ApexNav devel in-container.
export CATKIN_DEVEL_PREFIX="${CATKIN_DEVEL_PREFIX:-/workspace/VLN_Mobilemanipulator/.catkin_devel_integrate}"
export ROS_PORT="${ROS_PORT:-11316}"
export OUT_DIR="${OUT_DIR:-/media/ubuntu/D/VLN_shared/runs/habitat_rangercr10/apexnav_real_integrate}"
export ROBOT_SCALE="${ROBOT_SCALE:-0.7}"
export CAMERA_MODE="${CAMERA_MODE:-fixed_base_gimbal}"
# ################################
# Default LOOK = trained teleop-PPO EE pitch (not simulated gimbal).
# Host precomputes PPO_LOOK_DIR via run_ppo_ee_look_bundle_host.sh.
# Episode forces legacy_arm_look FK when LOOK_BACKEND=ppo_ee_rpy.
# Override: LOOK_BACKEND=gimbal for legacy optical-only LOOK.
# ################################
export LOOK_BACKEND="${LOOK_BACKEND:-ppo_ee_rpy}"
export PPO_LOOK_CKPT="${PPO_LOOK_CKPT:-models/ranger_cr10/model_9999.pt}"
export PPO_LOOK_DIR="${PPO_LOOK_DIR:-/media/ubuntu/D/VLN_shared/runs/habitat_rangercr10/ppo_look_bundle_model9999}"
export PPO_RAISE_JSON="${PPO_RAISE_JSON:-/media/ubuntu/D/VLN_shared/runs/habitat_rangercr10/ppo_raise_stage410d_z040.json}"
# ################################
# Chassis MOVE/TURN low-level: trained teleop-PPO vel_cmd unit segments.
# Host: run_ppo_chassis_bundle_host.sh → PPO_CHASSIS_DIR.
# Override: EXEC_BACKEND=kinematic
# ################################
export EXEC_BACKEND="${EXEC_BACKEND:-ppo_chassis}"
export PPO_CHASSIS_DIR="${PPO_CHASSIS_DIR:-/media/ubuntu/D/VLN_shared/runs/habitat_rangercr10/ppo_chassis_bundle_model9999}"
export STARTUP_PRIOR_MODE="${STARTUP_PRIOR_MODE:-initial_footprint}"
export STARTUP_PRIOR_EXPAND_M="${STARTUP_PRIOR_EXPAND_M:-0.3}"
export OBSTACLE_DENOISE="${OBSTACLE_DENOISE:-none}"
export SKIP_DEMO="${SKIP_DEMO:-1}"
# ################################
# Default planning: hard inflate 0.20 m + soft cost R=0.10/w=2.0 + reverse Hybrid A* (C).
# Historical reproduce: INFLATION_PROFILE=legacy018  REVERSE_PLANNING_MODE=A|B
# ################################
export INFLATION_PROFILE="${INFLATION_PROFILE:-inf020_soft010}"
export OBSTACLES_INFLATION="${OBSTACLES_INFLATION:-0.20}"
export LOCK_OBSTACLES_INFLATION="${LOCK_OBSTACLES_INFLATION:-true}"
export SOFT_COST_RANGE_M="${SOFT_COST_RANGE_M:-0.10}"
export SOFT_COST_WEIGHT="${SOFT_COST_WEIGHT:-2.0}"
export REVERSE_PLANNING_MODE="${REVERSE_PLANNING_MODE:-C}"
# Other candidate switches (override per job):
# export BLOCKED_RECOVERY_MODE=legacy|v2
# export ENABLE_NO_FRONTIER_LOOK=false|true
# export LOOK_BACKEND=gimbal
# export EXEC_BACKEND=kinematic
# export PPO_RAISE_JSON=   # empty disables Z-raise handover
# export INFLATION_PROFILE=legacy018
# export REVERSE_PLANNING_MODE=A|B
# ################################
