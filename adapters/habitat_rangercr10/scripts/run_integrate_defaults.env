# ################################
# Source before run_apexnav_real_episode.sh for the integrate worktree.
# ################################
export CONTAINER=vln-rangercr10-integrate
export CATKIN_DEVEL_PREFIX=/workspace/VLN_Mobilemanipulator/.catkin_devel_integrate
export ROS_PORT="${ROS_PORT:-11316}"
export OUT_DIR="${OUT_DIR:-/media/ubuntu/D/VLN_shared/runs/habitat_rangercr10/apexnav_real_integrate}"
export ROBOT_SCALE="${ROBOT_SCALE:-0.7}"
export CAMERA_MODE="${CAMERA_MODE:-fixed_base_gimbal}"
export STARTUP_PRIOR_MODE="${STARTUP_PRIOR_MODE:-initial_footprint}"
export STARTUP_PRIOR_EXPAND_M="${STARTUP_PRIOR_EXPAND_M:-0.3}"
export OBSTACLE_DENOISE="${OBSTACLE_DENOISE:-none}"
export SKIP_DEMO="${SKIP_DEMO:-1}"
# Candidate switches (override per job):
# export INFLATION_PROFILE=legacy018|inf020_soft010
