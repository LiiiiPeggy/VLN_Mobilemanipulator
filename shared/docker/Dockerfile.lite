# Lightweight audit image for APRR / SG-Nav / UniGoal source+deps inspection.
FROM pytorch/pytorch:2.3.1-cuda12.1-cudnn8-runtime

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

RUN apt-get update && apt-get install -y --no-install-recommends \
    git curl wget ca-certificates vim unzip libgl1 libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

RUN pip install --upgrade pip \
 && pip install omegaconf hydra-core opencv-python-headless flask networkx tqdm pyyaml

WORKDIR /workspace
CMD ["bash"]
