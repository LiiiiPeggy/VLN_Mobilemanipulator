# Shared Habitat 0.2.5 + CUDA base for MSGNav / SG-Nav / UniGoal-class stacks.
FROM nvidia/cuda:11.8.0-cudnn8-devel-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive \
    LANG=C.UTF-8 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    TORCH_HOME=/shared/cache/torch \
    HF_HOME=/shared/cache/huggingface \
    TRANSFORMERS_CACHE=/shared/cache/huggingface \
    CONDA_DIR=/opt/conda

RUN apt-get update && apt-get install -y --no-install-recommends \
    git curl wget ca-certificates build-essential cmake ninja-build \
    libgl1-mesa-glx libglib2.0-0 libsm6 libxext6 libxrender1 libegl1 \
    python3.9 python3.9-dev python3-pip python-is-python3 \
    tmux vim unzip \
    && rm -rf /var/lib/apt/lists/*

# Miniconda for habitat-sim conda packages
RUN curl -fsSL https://repo.anaconda.com/miniconda/Miniconda3-py39_24.7.1-0-Linux-x86_64.sh -o /tmp/miniconda.sh \
 && bash /tmp/miniconda.sh -b -p ${CONDA_DIR} \
 && rm /tmp/miniconda.sh \
 && ${CONDA_DIR}/bin/conda clean -afy
ENV PATH=${CONDA_DIR}/bin:$PATH

RUN pip install --upgrade pip setuptools wheel \
 && pip install torch==2.0.1 torchvision==0.15.2 --index-url https://download.pytorch.org/whl/cu118 \
 && pip install omegaconf==2.3.0 open-clip-torch==2.26.1 ultralytics==8.2.31 supervision==0.21.0 \
      opencv-python-headless==4.10.0.84 scikit-learn==1.4 scikit-image==0.22 open3d==0.18.0 \
      openai==1.35.3 httpx==0.27.2 numpy==1.24.3 scipy==1.11.4 flask

# habitat-sim via conda (headless)
RUN conda install -y -c conda-forge -c aihabitat habitat-sim=0.2.5 headless faiss-cpu=1.7.4 \
 && conda clean -afy

WORKDIR /workspace
CMD ["bash"]
