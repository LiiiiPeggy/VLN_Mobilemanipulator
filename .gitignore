# Runtime artifacts (keep tiny summaries only)
runs/**
!runs/**/.gitkeep
!runs/**/summary.md
!runs/**/*.json
!runs/**/*.csv
!runs/**/*.txt
!runs/**/*.md
*.mp4
*.avi
*.mov
*.mkv
*.webm
*.gif
*.png
*.jpg
*.jpeg
*.so
!docs/**/*.png
!reports/**/*.png
# Keep empty run dirs in git
!runs/**/.gitkeep

# Logs
*.log
logs/
tmux*/

# Nested git leftovers (should be removed after import)
**/.git/
!**/.gitkeep

# Docker build cache leftovers
**/.dockerignore.bak

# Node (if any tooling)
node_modules/
