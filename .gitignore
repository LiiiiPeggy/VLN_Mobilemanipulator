# Runtime artifacts (keep tiny summaries only).
# Must un-ignore directories (`!runs/**/`) before file exceptions can apply.
runs/**
!runs/**/
!runs/**/.gitkeep
!runs/**/*.md
!runs/**/*.json
!runs/**/*.csv
!runs/**/*.txt
*.mp4
*.avi
*.mov
*.mkv
*.webm
*.gif
*.png
*.jpg
*.jpeg
*.so
!docs/**/*.png
!reports/**/*.png

# Logs
*.log
logs/
tmux*/

# Nested git leftovers (should be removed after import)
**/.git/
!**/.gitkeep

# Docker build cache leftovers
**/.dockerignore.bak

# Node (if any tooling)
node_modules/

